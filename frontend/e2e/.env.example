# Copy this to `.env` once:  cp .env.example .env
# Then edit only the line(s) whose default doesn't match your machine. These are the local-dev
# defaults, so if your stack runs where they say, you can copy-and-go without editing anything.
# (These values, or a matching shell/CI env var, override the built-in defaults baked into the code.)

# URL of the running dev server (Playwright's baseURL; proxies /api -> the backend).
BASE_URL=http://localhost:3000

# Admin connection to your local seeded DB — used by the seed-patch scripts (scripts/apply-patches.sh,
# teardown-patches.sh) and any DB-cleanup helpers you add.
ORACLE_DSN=THE/default@localhost:1525/DBDOCK_01

# Only used if you have NO local `sqlplus`: the seed-patch scripts then run sqlplus inside this Docker
# container automatically. Set it to your container's name (convention: real-data-seeded-<app>-db,
# e.g. real-data-seeded-ilcr-db). Ignored when a local sqlplus is present.
DB_CONTAINER=real-data-seeded-db
